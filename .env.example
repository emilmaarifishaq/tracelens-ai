UPLOAD_DIR=uploads
DECODED_DIR=decoded

# AI Provider Configuration -- this is only a server-side default; the
# Settings panel in the web UI lets you pick a provider and enter a key
# per-request instead (nothing is persisted server-side either way).
# Options: rule-engine (offline), openai, claude, gemini, azure, ollama, generic
# rule-engine: Local analysis only, no API key needed
# openai: OpenAI GPT models (requires API key from https://platform.openai.com/api-keys)
# claude: Anthropic Claude (requires API key from https://console.anthropic.com/)
# gemini: Google Gemini (requires API key from https://aistudio.google.com/apikey)
# azure: Azure OpenAI (requires Azure endpoint and API key)
# ollama: Local LLM via Ollama (no API key needed, runs locally)
# generic: Any OpenAI-compatible endpoint (Groq, Mistral, etc.)
AI_PROVIDER=rule-engine
AI_API_KEY=
AI_MODEL=gpt-4o
AI_BASE_URL=https://api.openai.com/v1/chat/completions
AI_WEB_SEARCH_ENABLED=false

# Backward-compatible aliases (used if AI_API_KEY not set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
